{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nexus.local/schemas/spec.v1.json",
  "title": "NEXUS Spec V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "spec_id", "title", "rigor_level", "requirements", "acceptance_criteria", "non_goals", "status"],
  "properties": {
    "schema_version": {"const": "nexus.spec.v1"},
    "spec_id": {"type": "string", "minLength": 1},
    "title": {"type": "string", "minLength": 1},
    "rigor_level": {"enum": ["L0_TRIVIAL", "L1_STANDARD", "L2_CRITICAL", "L3_HIGH_ASSURANCE", "L4_RESEARCH_SAFETY_CRITICAL"]},
    "requirements": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "acceptance_criteria": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "non_goals": {"type": "array", "items": {"type": "string"}},
    "status": {"enum": ["DRAFT", "REVIEW", "APPROVED", "BLOCKED", "SUPERSEDED"]}
  }
}
