{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nexus.local/schemas/task.v1.json",
  "title": "NEXUS Task V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "task_id", "spec_id", "requirements", "tests", "status"],
  "properties": {
    "schema_version": {"const": "nexus.task.v1"},
    "task_id": {"type": "string", "minLength": 1},
    "spec_id": {"type": "string", "minLength": 1},
    "requirements": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "files": {"type": "array", "items": {"type": "string"}},
    "tests": {"type": "array", "items": {"type": "string"}},
    "status": {"enum": ["PLANNED", "IN_PROGRESS", "IMPLEMENTED", "VERIFIED", "BLOCKED", "NOT_APPLICABLE"]}
  }
}
